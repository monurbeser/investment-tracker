# DATA_MODE=live  -> gerçek kaynaklar (varsayılan)
# DATA_MODE=demo  -> ağ erişimi yokken arayüzü denemek için sentetik veri (ekranda DEMO olarak işaretlenir)
DATA_MODE=live

# Binance REST uç noktası (api.binance.com erişilemezse data-api.binance.vision kullanılır)
BINANCE_REST=https://api.binance.com

# UAE tahvil modeli için ABD Hazine getirisine eklenen varsayılan spreadler (baz puan)
BOND_SPREAD_UAE_FED_BP=45
BOND_SPREAD_ABU_DHABI_BP=50
BOND_SPREAD_DUBAI_BP=110
